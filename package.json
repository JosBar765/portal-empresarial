{
  "name": "portal-empresarial",
  "version": "1.0.0",
  "description": "Portal Web de Herramientas Empresariales modular e interactivo.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:estado": "node scripts/migrate.js --estado",
    "staging:probar-conexion": "node scripts/staging/probar-conexion.js",
    "staging:marcar": "node scripts/staging/marcar.js",
    "staging:refrescar": "node scripts/staging/refrescar.js",
    "main:backup": "node scripts/backup/respaldar.js",
    "main:backup:probar-guarda": "node scripts/backup/probar-guarda.js",
    "ci:sintaxis": "node scripts/ci/sintaxis.js",
    "ci:migraciones": "node scripts/ci/migraciones.js",
    "ci:arranque": "node scripts/ci/arranque.js",
    "ci": "npm run ci:sintaxis && npm run ci:migraciones && npm run ci:arranque"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.9.7",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "overrides": {
    "qs": "^6.16.0"
  }
}

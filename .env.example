# Portal Web de Herramientas Empresariales - Variables de Entorno

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de JWT
JWT_SECRET=cambiar_este_secreto_en_produccion_1234567890
JWT_EXPIRES_IN=24h

# Configuración de Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_empresarial

# Configuración Adicional de Socket.IO / WebSockets (si aplica)
# SOCKET_CORS_ORIGIN=*

# Configuración de Supabase Storage (almacenamiento de PDFs e imágenes de
# Vales de Arte — exclusivamente eso, la base de datos de negocio del portal
# sigue siendo MySQL). Solo se usa desde el backend (nunca desde el
# navegador), así que SUPABASE_SERVICE_ROLE_KEY debe llevar la key de
# servidor con permiso total sobre el bucket — en el dashboard de Supabase
# puede aparecer como "service_role" (formato JWT, legado) o como "secret
# key" (formato sb_secret_..., el reemplazo actual) según cuándo se creó el
# proyecto; cualquiera de las dos funciona igual aquí. NUNCA la
# "publishable key" / "anon key" — esas son para código que sí llega al
# navegador, y este proyecto no expone Supabase al frontend en absoluto.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vales_de-arte

# Portal Web de Herramientas Empresariales - Variables de Entorno

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Sesiones
SESSION_SECRET=cambiar_este_secreto_en_produccion_1234567890

# Configuración de Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306

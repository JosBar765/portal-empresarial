# Portal Web de Herramientas Empresariales - Variables de Entorno
#
# TODAS las variables son obligatorias y no hay valores por defecto: si falta
# alguna (o tiene un formato inválido) el servidor imprime un [FATAL] por cada
# una y no arranca. Copia este archivo a .env y completa los valores reales.

# --- Servidor ---
# Puerto donde escucha Node. En Hostinger usa el que asigne la plataforma.
PORT=3000
# development | production | test. En producción: production (activa cookies Secure).
NODE_ENV=development

# --- JWT ---
# Secreto para firmar los tokens: mínimo 32 caracteres, aleatorio y distinto por entorno.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar_este_secreto_en_produccion_1234567890
# Vida del access token y vida máxima de la sesión. Formato: entero + s|m|h|d (30s, 15m, 12h, 7d).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=12h

# --- WebSocket (Socket.IO) ---
# Origen(es) del navegador autorizados a conectarse: esquema + dominio, sin barra final
# ni "*". Varios separados por coma. En producción: https://tu-dominio.com
SOCKET_CORS_ORIGIN=http://localhost:3000

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
# Puede quedar vacía solo en desarrollo local; en producción es obligatoria.
DB_PASSWORD=
DB_NAME=portal_empresarial

# --- Supabase Storage (PDFs e imágenes de los vales) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
